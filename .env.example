# Use 127.0.0.1:PORT in the browser (not localhost — another app may bind localhost on common ports)
PORT=3847
NODE_ENV=development

# Duffel — https://app.duffel.com/
DUFFEL_ACCESS_TOKEN=
DUFFEL_WEBHOOK_SECRET=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Loyalty / merchandising
LOYALTY_EARN_PCT=2
MEMBER_DISCOUNT_PCT=4
MARKETPLACE_COMMISSION_PCT=12
MARKETPLACE_CUTOFF_HOURS=6

# Optional multi-supplier stubs (off by default)
SUPPLIER_SKYBIRD_ENABLED=false
SUPPLIER_VAX_ENABLED=false

# Seed admin (created on first boot if no users exist)
ADMIN_EMAIL=admin@korabi.test
ADMIN_PASSWORD=changeme

# Postgres (optional — swap store.js → store.pg.js when ready)
# DATABASE_URL=postgres://user:pass@localhost:5432/korabi

# Stripe Connect (optional — holdViaStripe / releaseViaStripe / refundViaStripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Shteg R09 Anti-ARC settlement (optional — post-booking FedNow direct rail)
# SHTEG_API_BASE_URL=http://127.0.0.1:3000
# SHTEG_API_BEARER=           # Firebase ID token or service bearer
# SHTEG_SETTLEMENT_MODE=sandbox  # off | sandbox | live
# SHTEG_AGENCY_ID=korabi
# SHTEG_ARC_NUMBER=           # hybrid: ARC TDR fallback for non-R09 carriers

# Checkout: korabi (split book+settle) | shteg_atomic (single gds/book-and-settle when live)
# KORABI_CHECKOUT_MODE=korabi
